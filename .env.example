# Server-Konfiguration für Hostinger (Node.js Umgebung)
PORT=3000
NODE_ENV=production

# Optionale Gemini API für erweiterte Audio-Transkription & KI-Features
# Hinweis: Wenn kein Schlüssel hinterlegt ist, nutzt "Laras Tagebuch" automatisch
# die native Browser-Sprachausgabe (Web Speech API) und lokale Standardmedien.
GEMINI_API_KEY=""
